# Server
PORT=5000
NODE_ENV=development

# Database
# Create an empty MySQL database, then run npm run db:setup from backend/.
# schema.sql is for fresh MySQL installations, not a PostgreSQL migration.
# Existing marketplace MySQL databases: back up, stop API traffic, then run npm run db:migrate.
# The repeatable upgrade adds refund columns without dropping tables or changing records.
# Audit any legacy cancelled/paid bookings before restart; failed-refund cancellations
# from older code cannot safely be restored automatically if dates were rebooked.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=equipment_rental_db
DB_USER=equipment_rental
DB_PASSWORD=your_password

# JWT
# Set a random secret of at least 32 characters (e.g. openssl rand -hex 32).
JWT_SECRET=
# Positive duration in seconds/minutes/hours/days, with a unit.
JWT_EXPIRE=7d
# API limits: 300 requests per IP per 15 minutes; signup/login: 20.
# Multi-instance deployments should enforce shared limits at their ingress.
# Send JWTs in the HTTP Authorization header on protected calls (see middleware/auth.js).

# Stripe (Payment)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# Configure Stripe to send refund.updated/refund.failed to /api/payments/webhook.
# Retry /payments/refund to reconcile interrupted requests. Ambiguous requests older
# than 23 hours remain blocked if Stripe has no matching refund; reconcile manually.
STRIPE_WEBHOOK_SECRET=

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
